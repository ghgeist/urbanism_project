# ---------------------------------------------------------------------------
# urbanism_project / .env.example
# Copy this to `.env` and fill in values for local development.
# ---------------------------------------------------------------------------
# services/db.py autoloads this file via python-dotenv with override=False,
# so any real values set in the process environment (e.g. on Replit) take
# precedence over what's in here.
# ---------------------------------------------------------------------------

# --- Database (pick ONE of these two options) -------------------------------

# Option A: a single connection URL (used as-is; postgres:// is rewritten to
# postgresql:// for SQLAlchemy). For remote databases (Neon, Replit, etc.)
# you must use the external/public URL — Replit-internal hostnames like
# "helium" do not resolve from your local machine.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Option B: individual PG* variables (used when DATABASE_URL is unset).
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=walkability
# PGUSER=postgres
# PGPASSWORD=change_me

# --- API runtime ------------------------------------------------------------

# Optional: override CORS allow-list (comma-separated). Defaults suit
# localhost development; always set this in production.
# API_CORS_ORIGINS=http://localhost:5173

# Set to 1 to emit structured JSON debug logs from services/walkability.py.
# Leave unset in production.
# WALKABILITY_DEBUG_LOG=0

# --- Walkable Accessibility Score (WAS) loader ------------------------------
# Used by scripts/load_walkable_accessibility_score.py and the WAS-availability
# cache in services/walkability.py. None of these are required for running
# the API once the WAS table is loaded; they only matter at ingest time or
# when tuning cache behavior.

# Local path to the WAS shapefile bundle (.shp or .shp.zip). Defaults to
# US_WAS_1997_2019.shp.zip at the repo root if unset.
# WAS_SHAPEFILE_PATH=US_WAS_1997_2019.shp.zip

# Optional remote URL for the WAS shapefile. When set, the loader downloads
# into a temp file instead of reading WAS_SHAPEFILE_PATH.
# WAS_SHAPEFILE_URL=https://example.com/US_WAS_1997_2019.shp.zip

# Set to 1 to skip the loader's interactive "DROP + reload" confirmation
# prompt. Useful for CI/one-shot runs on Replit where there is no TTY.
# WAS_LOADER_CONFIRM=0

# TTL (seconds) for the in-process "is the WAS table present?" cache used
# by services/walkability.py. Defaults to 300s. Lower values re-probe more
# often (useful while the loader is being run mid-deployment); higher
# values reduce the probe overhead.
# WAS_CACHE_TTL_SECONDS=300
